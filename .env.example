# =============================================================
# Self-Healing Text-to-SQL Agent — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# Google Gemini API Key (get free at https://aistudio.google.com/)
GOOGLE_API_KEY=your-gemini-api-key-here

# Database URL
# SQLite (default — zero setup):
DATABASE_URL=sqlite:///data/sample.db
# PostgreSQL (uncomment to use):
# DATABASE_URL=postgresql://user:password@localhost:5432/text_to_sql

# Gemini model to use (free tier)
LLM_MODEL=gemini-3.6-flash

# Max self-healing retry attempts
MAX_RETRIES=3
